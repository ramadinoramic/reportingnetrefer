# MySQL connection (used by ETL; matches docker-compose.yml)
MYSQL_HOST=localhost
MYSQL_PORT=3308
MYSQL_USER=netrefer_etl
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=netrefer_reporting

# MySQL root password (used by docker-compose to create the db)
MYSQL_ROOT_PASSWORD=rootpassword

# Folder where you drop Netrefer CSV exports
CSV_DROP_DIR=./drop
PROCESSED_DIR=./drop/processed

LOG_LEVEL=INFO

# ── File watcher ──────────────────────────────────────────────────────────────
# How often (seconds) the watcher polls drop/ for new CSVs (default: 60)
WATCHER_POLL_SECONDS=60

# ── Email delivery (board report) ─────────────────────────────────────────────
# Required only if you use: make board-report EMAIL=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
# SMTP_FROM=Affiliate Reporting <your@gmail.com>   # optional display name

# ── Telegram Bot ───────────────────────────────────────────────────────────────
# 1. Create bot:        message @BotFather on Telegram → /newbot → copy token
# 2. Get your user ID:  message @userinfobot on Telegram → copy the number
# 3. Get Anthropic key: console.anthropic.com → API Keys → Create
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_ALLOWED_USERS=123456789,987654321   # comma-separated Telegram user IDs
ANTHROPIC_API_KEY=sk-ant-...

# ── Cloudflare Tunnel ──────────────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token

# ── Cost Tracking (Google Sheets → MySQL) ─────────────────────────────────────
# 1. Create a Google Service Account:
#    console.cloud.google.com → IAM → Service Accounts → Create
#    Add role: "Viewer"  →  Keys → Add Key → JSON → download
# 2. Save the downloaded JSON key to credentials/google_sa.json
# 3. Open your "Affiliate Cost Tracker" Google Sheet → Share → add the
#    service account email (ends in @...iam.gserviceaccount.com) with Viewer access
# 4. Copy the Sheet ID from the URL:
#    https://docs.google.com/spreadsheets/d/SHEET_ID_HERE/edit
GOOGLE_SA_KEY_PATH=credentials/google_sa.json
COST_SHEET_ID=your_google_sheet_id_here
