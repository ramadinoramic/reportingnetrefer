# Netrefer API credentials
NETREFER_API_KEY=your_api_key_here
NETREFER_API_URL=https://api.netrefer.com/v1/reports

# MySQL connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=looker_etl
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=netrefer_reporting

# ETL settings
CSV_DROP_DIR=/data/netrefer/incoming
PROCESSED_DIR=/data/netrefer/processed
LOG_LEVEL=INFO
