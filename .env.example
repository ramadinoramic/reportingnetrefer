# MySQL connection (used by ETL; matches docker-compose.yml)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=netrefer_etl
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=netrefer_reporting

# MySQL root password (used by docker-compose to create the db)
MYSQL_ROOT_PASSWORD=rootpassword

# Folder where you drop Netrefer CSV exports
CSV_DROP_DIR=./drop
PROCESSED_DIR=./drop/processed

LOG_LEVEL=INFO
